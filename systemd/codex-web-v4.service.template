[Unit]
Description=codex-web-v4 - especialistas que conversan entre si
Documentation=file://__APP_DIR__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__APP_DIR__
Environment=NODE_OPTIONS=--no-warnings
Environment=V4_CONFIG=__CONFIG__
Environment=HOME=__DATA_DIR__
ExecStart=__NODE__ __APP_DIR__/src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Los agentes son herramientas de desarrollo: necesitan privilegios reales sobre
# el proyecto y sobre los servicios que administran. No se aislan del sistema.
UMask=0027
StandardOutput=append:__DATA_DIR__/logs/service.log
StandardError=append:__DATA_DIR__/logs/service.log

[Install]
WantedBy=multi-user.target
